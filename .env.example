# ─────────────────────────────────────────────────────────────────────────────
# Montefiore PDF/UA Remediation Suite — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your API keys.
#
# Configuration reference: openclaw_migration/GATEWAY_CONFIG.md
# Workflow reference:       openclaw_migration/WORKFLOW.md
# ─────────────────────────────────────────────────────────────────────────────


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Your API key for the primary model provider.
# See GATEWAY_CONFIG.md for which variable to use per provider.
PRIMARY_PROVIDER_API_KEY=


# ─── PRIMARY MODEL ───────────────────────────────────────────────────────────
# Handles all audit, repair, and packaging decisions.
# Must support: tool calling, JSON mode, 32K+ context window.

# API endpoint (OpenAI-compatible). See GATEWAY_CONFIG.md for options.
PRIMARY_PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1

# Model ID string — must match exactly what your provider expects.
PRIMARY_MODEL=stepfun-ai/step-3.5-flash


# ─── VISUAL QA MODEL ─────────────────────────────────────────────────────────
# Used only for post-repair visual page comparison.
# Must support image/vision input.
#
# If your primary provider handles vision too (OpenAI, Anthropic, OpenRouter),
# set VISION_MODEL only — leave the two VISION_PROVIDER fields blank and
# primary credentials will be reused automatically.

VISION_PROVIDER_BASE_URL=
VISION_PROVIDER_API_KEY=
VISION_MODEL=nvidia/nemotron-3-nano-omni-reasoning-30b-a3b


# ─── WORKSPACE ───────────────────────────────────────────────────────────────
# Absolute path to your workspace directory on your HOST machine.
# This is mounted into the container — PDFs and job data live here,
# NOT inside Docker. Use an absolute path.
#
# Examples:
#   macOS/Linux: WORKSPACE_PATH=/Users/yourname/montefiore-workspace
#   Windows:     WORKSPACE_PATH=C:/Users/yourname/montefiore-workspace
#
# The directory will be created on first run if it does not exist.
# See WORKFLOW.md for the full workspace folder structure.

WORKSPACE_PATH=/Users/yourname/montefiore-workspace


# ─── TOOL PATHS ──────────────────────────────────────────────────────────────
# Set automatically inside Docker. Only change if running outside the container.

VERAPDF_BIN=/opt/verapdf/verapdf
QPDF_BIN=/usr/bin/qpdf
